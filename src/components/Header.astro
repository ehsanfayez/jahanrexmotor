---
import { translator } from '../data/i18n';
const t = translator(Astro.currentLocale);

import Brand from './Brand.astro';
import Icon from './Icon.astro';
import '../styles/header.css';
import LanguageSwitcher from './LanguageSwitcher.astro';
---
<header class="header" data-header><div class="header-inner shell"><Brand />
<button class="menu-toggle" data-menu-toggle aria-controls="navigation" aria-expanded="false" type="button">{t("منو")}<span class="menu-symbol" aria-hidden="true"><i></i><i></i></span></button>
<nav id="navigation" class="navigation" data-navigation aria-label={t("ناوبری اصلی")}><a href="#parts">{t("دنیای قطعات")}</a><a href="#about">{t("درباره جهانرکسان")}</a><a href="#approach">{t("نگاه ما")}</a><a class="mobile-contact" href="#contact">{t("اطلاعات تماس")}</a></nav>
<a class="header-cta" href="#contact">{t("گفت‌وگو برای همکاری")}<Icon name="messages-square" size={20} /></a><LanguageSwitcher /></div></header>
