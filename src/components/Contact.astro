---
import { translator } from '../data/i18n';
const t = translator(Astro.currentLocale);

import { contact } from '../data/landing';
import Icon from './Icon.astro';
import '../styles/closing.css';
---
<section id="contact" class="cooperation" aria-labelledby="contact-title">
  <div class="shell cooperation-grid">
    <div class="cooperation-copy">
      <p class="closing-eyebrow"><span></span>{t("فصل بعدی، با گفت‌وگو آغاز می‌شود")}</p>
      <h2 id="contact-title">{t("برای همکاری‌های بزرگ،")}<br />{t("از یک")} <span class="conversation-emphasis">{t("گفت‌وگو")}</span> <span class="cooperation-ending">{t("شروع کنیم.")}</span></h2>
      <p class="cooperation-description">{t("برای ارتباط و گفت‌وگو درباره زمینه‌های همکاری با جهانرکسان موتور، با ما در تماس باشید.")}</p>
    </div>
    <div id="contact-details" class="cooperation-action" aria-label={t("اطلاعات تماس جهانرکسان موتور")}>
      <span class="contact-channel">{t("ارتباط مستقیم")}</span>
      <a class="contact-number" href={`tel:${contact.phone}`} aria-label={`${t('تماس با جهانرکسان موتور')} ${contact.phone}`}><bdi dir="ltr">{contact.phone}</bdi></a>
      <a class="closing-call" href={`tel:${contact.phone}`}>{t("تماس با جهانرکسان موتور")}<Icon name="phone-call" size={22} /></a>
      <p>{t("برای شروع یک همکاری حرفه‌ای")}</p>
    </div>
  </div>
</section>
