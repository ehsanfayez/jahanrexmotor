# Copy to .env.prod and fill in. Do not commit .env.prod.
# Public domain routed by Traefik.
SITE_DOMAIN=jahanrexanmotor.ir
# Host port for direct access (bypassing Traefik).
SITE_PORT=8688
# External Docker network shared with Traefik.
DOCKER_NETWORK=jahan
# Optional npm mirror for the build stage.
NPM_REGISTRY=https://mirror.abrha.net/repository/npm/
